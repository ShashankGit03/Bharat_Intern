# File discovery helpers
from pathlib import Path
import re


def find_files(base_dir: str, pattern: str) -> List[str]:
    return sorted(glob.glob(os.path.join(base_dir, pattern), recursive=True))


def pick_best(paths: List[str]) -> Optional[str]:
    if not paths:
        return None
    # Heuristic: choose the largest file assuming it's the main dataset
    try:
        paths_sorted = sorted(paths, key=lambda p: os.path.getsize(p), reverse=True)
        return paths_sorted[0]
    except Exception:
        return paths[0]


def autodiscover_inputs() -> Dict[str, Optional[str]]:
    train_iv_files = find_files(INPUT_DIR, cfg.train_iv_pattern)
    train_ohlcv_files = find_files(INPUT_DIR, cfg.train_ohlcv_pattern)
    test_ohlcv_files = find_files(INPUT_DIR, cfg.test_ohlcv_pattern)
    orderbook_files = find_files(INPUT_DIR, cfg.orderbook_pattern)
    peers_files = find_files(INPUT_DIR, cfg.peers_pattern)

    discovered = {
        "train_iv": pick_best(train_iv_files),
        "train_ohlcv": pick_best(train_ohlcv_files),
        "test_ohlcv": pick_best(test_ohlcv_files),
        "orderbook": pick_best(orderbook_files),
        "peers": peers_files[:10] if len(peers_files) > 0 else [],  # allow multiple peers
    }
    return discovered


discovered_paths = autodiscover_inputs()
