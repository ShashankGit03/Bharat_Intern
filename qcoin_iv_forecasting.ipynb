from collections import deque


def add_time_index(df: pd.DataFrame, ts_col: str) -> pd.DataFrame:
    df = df.sort_values(ts_col).copy()
    df["t_idx"] = (df[ts_col].view('int64') // 1_000_000_000).astype(np.int64)
    return df


def make_ohlcv_features(df: pd.DataFrame, ts_col: str,
                        price_col: Optional[str] = None,
                        vol_col: Optional[str] = None,
                        prefix: str = "q") -> pd.DataFrame:
    if df is None:
        return None
    df = add_time_index(df, ts_col)

    # Choose price proxy: close or mid of OHLC if exists
    cols = df.columns.str.lower()
    close_candidate = None
    for c in ["close", "price", "last", "mid", "vwap"]:
        if c in cols:
            close_candidate = df.columns[cols == c][0]
            break
    if price_col is None:
        price_col = close_candidate if close_candidate else df.columns[1]

    if vol_col is None:
        vol_candidate = None
        for c in ["volume", "vol", "qty", "size"]:
            if c in cols:
                vol_candidate = df.columns[cols == c][0]
                break
        vol_col = vol_candidate

    df = df[[ts_col, "t_idx", price_col] + ([vol_col] if vol_col else [])].copy()
    df.rename(columns={price_col: f"{prefix}_price"}, inplace=True)
    if vol_col:
        df.rename(columns={vol_col: f"{prefix}_vol"}, inplace=True)

    # Log returns and realized volatility proxies
    df[f"{prefix}_logp"] = np.log(df[f"{prefix}_price"].replace(0, np.nan)).ffill()
    for w in [5, 10, 20, 60, 120, 300]:
        df[f"{prefix}_ret_{w}s"] = df[f"{prefix}_logp"].diff(w)
        df[f"{prefix}_rv_{w}s"] = (
            df[f"{prefix}_ret_{w}s"].rolling(w, min_periods=max(2, w//2)).std()
        )
    if f"{prefix}_vol" in df.columns:
        for w in [10, 30, 60, 120, 300]:
            df[f"{prefix}_vol_roll_{w}s"] = (
                df[f"{prefix}_vol"].rolling(w, min_periods=max(3, w//3)).sum()
            )
    return df


def make_orderbook_features(df: pd.DataFrame, ts_col: str, prefix: str = "ob") -> pd.DataFrame:
    if df is None:
        return None
    df = add_time_index(df, ts_col)

    # Identify levels
    # Expect columns like bid_price_1, bid_size_1, ask_price_1, ask_size_1, ...
    cols = df.columns
    bid_price_cols = [c for c in cols if re.match(r"bid.*price.*\d+", c, re.I)]
    ask_price_cols = [c for c in cols if re.match(r"ask.*price.*\d+", c, re.I)]
    bid_size_cols = [c for c in cols if re.match(r"bid.*(size|qty).*\d+", c, re.I)]
    ask_size_cols = [c for c in cols if re.match(r"ask.*(size|qty).*\d+", c, re.I)]

    def safe_mid(row):
        bp = row[bid_price_cols[0]] if bid_price_cols else np.nan
        ap = row[ask_price_cols[0]] if ask_price_cols else np.nan
        if np.isfinite(bp) and np.isfinite(ap) and ap > 0 and bp > 0:
            return 0.5 * (bp + ap)
        return np.nan

    out = df[[ts_col, "t_idx"]].copy()

    # Top of book features
    if bid_price_cols and ask_price_cols:
        df["mid"] = df.apply(safe_mid, axis=1)
        out[f"{prefix}_mid"] = df["mid"].ffill()
        out[f"{prefix}_spread_abs"] = (df[ask_price_cols[0]] - df[bid_price_cols[0]]).clip(lower=0)
        out[f"{prefix}_spread_rel"] = out[f"{prefix}_spread_abs"] / df["mid"].replace(0, np.nan)

    # Depth imbalance
    if bid_size_cols and ask_size_cols:
        df["bid_depth"] = df[bid_size_cols].sum(axis=1)
        df["ask_depth"] = df[ask_size_cols].sum(axis=1)
        out[f"{prefix}_imbalance"] = (df["bid_depth"] - df["ask_depth"]) / (df["bid_depth"] + df["ask_depth"] + 1e-9)

    # Slippage proxies: weighted prices up to 3 levels if available
    for L in [1, 3, 5]:
        try:
            bid_p = [c for c in bid_price_cols if re.search(fr"\b{L}$", c)]
            ask_p = [c for c in ask_price_cols if re.search(fr"\b{L}$", c)]
            bid_s = [c for c in bid_size_cols if re.search(fr"\b{L}$", c)]
            ask_s = [c for c in ask_size_cols if re.search(fr"\b{L}$", c)]
            if bid_p and ask_p and bid_s and ask_s:
                bp = df[bid_p[0]]; ap = df[ask_p[0]]; bs = df[bid_s[0]]; asz = df[ask_s[0]]
                out[f"{prefix}_w_bid_{L}"] = (bp * bs) / (bs + 1e-9)
                out[f"{prefix}_w_ask_{L}"] = (ap * asz) / (asz + 1e-9)
        except Exception:
            pass

    # Rolling volatility of mid and spread
    if f"{prefix}_mid" in out.columns:
        out[f"{prefix}_logm"] = np.log(out[f"{prefix}_mid"].replace(0, np.nan)).ffill()
        for w in [5, 10, 20, 60]:
            out[f"{prefix}_mid_rv_{w}s"] = out[f"{prefix}_logm"].diff(w).rolling(w, min_periods=max(2, w//2)).std()
    if f"{prefix}_spread_abs" in out.columns:
        for w in [5, 10, 20, 60]:
            out[f"{prefix}_spread_roll_{w}s"] = out[f"{prefix}_spread_abs"].rolling(w, min_periods=max(2, w//2)).mean()

    return out


def make_peer_features(peer_dfs: List[pd.DataFrame], ts_col: str) -> Optional[pd.DataFrame]:
    if not peer_dfs:
        return None
    feats = []
    for i, p in enumerate(peer_dfs[:5]):
        pf = make_ohlcv_features(p, ts_col=ts_col, prefix=f"peer{i}")
        if pf is not None:
            feats.append(pf[[ts_col, "t_idx"] + [c for c in pf.columns if c not in [ts_col, "t_idx"]]])
    if not feats:
        return None
    # outer merge on time index
    out = feats[0]
    for f in feats[1:]:
        out = pd.merge_asof(
            out.sort_values("t_idx"), f.sort_values("t_idx"), on="t_idx",
            direction="nearest", tolerance=1
        )
    # Keep timestamp from the first peer
    return out
# Loaders and basic EDA utilities

def read_csv_safely(path: Optional[str], **kwargs) -> Optional[pd.DataFrame]:
    if path is None:
        return None
    try:
        df = pd.read_csv(path, **kwargs)
        return df
    except Exception as e:
        print(f"[WARN] Failed to read {path}: {e}")
        return None


def summarize_df(df: pd.DataFrame, name: str, ts_col: str):
    if df is None:
        print(f"{name}: None")
        return
    print(f"\n=== {name} summary ===")
    print("shape:", df.shape)
    print("columns:", df.columns.tolist())
    if ts_col in df.columns:
        print("time range:", df[ts_col].min(), "->", df[ts_col].max())
        # check uniqueness and monotonicity if ts numeric
        try:
            ts = pd.to_datetime(df[ts_col])
            print("n unique timestamps:", ts.nunique())
        except Exception:
            pass
    print(df.head(3))


train_iv = read_csv_safely(discovered_paths.get("train_iv"))
train_ohlcv = read_csv_safely(discovered_paths.get("train_ohlcv"))
orderbook = read_csv_safely(discovered_paths.get("orderbook"))
# peers may be multiple
peer_dfs = []
for p in discovered_paths.get("peers", []):
    peer_df = read_csv_safely(p)
    if peer_df is not None:
        peer_dfs.append(peer_df)

summarize_df(train_iv, "train_iv", cfg.timestamp_col)
