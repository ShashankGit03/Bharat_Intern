# Build training table

def assemble_training_table(
    train_iv: Optional[pd.DataFrame],
    train_ohlcv: Optional[pd.DataFrame],
    orderbook: Optional[pd.DataFrame],
    peer_dfs: List[pd.DataFrame],
    ts_col: str,
    target_col: str,
) -> pd.DataFrame:
    if train_iv is None:
        raise ValueError("Training IV labels not found")

    y = train_iv.copy()
    if ts_col in y.columns:
        y = y.sort_values(ts_col)
        y[target_col] = y[target_col].astype(float)
        y[ts_col] = pd.to_datetime(y[ts_col])
        y["t_idx"] = (y[ts_col].view('int64') // 1_000_000_000).astype(np.int64)

    X_parts = []
    if train_ohlcv is not None:
        X_parts.append(make_ohlcv_features(train_ohlcv, ts_col=ts_col, prefix="q"))
    if orderbook is not None:
        X_parts.append(make_orderbook_features(orderbook, ts_col=ts_col, prefix="ob"))
    if peer_dfs:
        pf = make_peer_features(peer_dfs, ts_col=ts_col)
        if pf is not None:
            X_parts.append(pf)

    # Merge parts using asof on t_idx to align nearest second
    X = None
    for part in X_parts:
        if part is None:
            continue
        part = part.sort_values("t_idx")
        if X is None:
            X = part
        else:
            X = pd.merge_asof(X.sort_values("t_idx"), part, on="t_idx",
                              direction="nearest", tolerance=1)

    if X is None:
        raise ValueError("No features available")

    # Merge target
    data = pd.merge_asof(
        X.sort_values("t_idx"), y[["t_idx", ts_col, target_col]].sort_values("t_idx"),
        on="t_idx", direction="nearest", tolerance=0
    )
    # Drop rows without target
    data = data.dropna(subset=[target_col])

    # Drop columns that leak or are non-numeric
    drop_cols = [ts_col]
    if ts_col in data.columns:
        drop_cols.append(ts_col)
    data = data.drop(columns=[c for c in drop_cols if c in data.columns], errors='ignore')

    # Handle inf and missing
    numeric_cols = data.select_dtypes(include=[np.number]).columns.tolist()
    data[numeric_cols] = data[numeric_cols].replace([np.inf, -np.inf], np.nan)
    data[numeric_cols] = data[numeric_cols].fillna(method='ffill').fillna(method='bfill')

    return data


