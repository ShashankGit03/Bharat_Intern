def assemble_inference_table(
    test_ohlcv_path: Optional[str],
    orderbook_path: Optional[str],
    peer_dfs: List[pd.DataFrame],
    ts_col: str,
) -> pd.DataFrame:
    test_ohlcv = read_csv_safely(test_ohlcv_path)
    test_orderbook = read_csv_safely(orderbook_path)

    # Enforce timestamp
    for df in [test_ohlcv, test_orderbook]:
        if df is not None and ts_col in df.columns:
            try:
                df[ts_col] = pd.to_datetime(df[ts_col])
            except Exception:
                pass

    X_parts = []
    if test_ohlcv is not None:
        X_parts.append(make_ohlcv_features(test_ohlcv, ts_col=ts_col, prefix="q"))
    if test_orderbook is not None:
        X_parts.append(make_orderbook_features(test_orderbook, ts_col=ts_col, prefix="ob"))
    if peer_dfs:
        pf = make_peer_features(peer_dfs, ts_col=ts_col)
        if pf is not None:
            X_parts.append(pf)

    X = None
    for part in X_parts:
        if part is None:
            continue
        part = part.sort_values("t_idx")
        if X is None:
            X = part
        else:
            X = pd.merge_asof(X.sort_values("t_idx"), part, on="t_idx",
                              direction="nearest", tolerance=1)

    if X is None:
        raise ValueError("No test features available. Check input discovery.")

    # Keep timestamp and t_idx for submission join
    # Forward/backward fill numeric gaps
    numeric_cols = X.select_dtypes(include=[np.number]).columns.tolist()
    X[numeric_cols] = X[numeric_cols].replace([np.inf, -np.inf], np.nan)
    X[numeric_cols] = X[numeric_cols].fillna(method='ffill').fillna(method='bfill')

    return X


