# Fixes: exclude t_idx from features consistently and re-run pipeline

# Redefine helpers to exclude t_idx from modeling features

def get_feature_target_clean(data: pd.DataFrame, target_col: str) -> Tuple[pd.DataFrame, np.ndarray, np.ndarray]:
    assert target_col in data.columns
    drop_non_features = {target_col, "t_idx"}
    feature_cols = [c for c in data.columns if c not in drop_non_features]
    X = data[feature_cols].copy()
    y = data[target_col].values.astype(np.float32)
    t_idx = data["t_idx"].values.astype(np.int64) if "t_idx" in data.columns else np.arange(len(data))
    X = to_float32(X)
    return X, y, t_idx


def train_time_series_cv_clean(data: pd.DataFrame, target_col: str, n_splits: int = 5):
    X, y, t_idx = get_feature_target_clean(data, target_col)
    feature_names = X.columns.tolist()

    # Ensure temporal order
    order = np.argsort(t_idx)
    X, y, t_idx = X.iloc[order], y[order], t_idx[order]

    splitter = TimeSeriesSplit(n_splits=n_splits)
    oof_pred = np.zeros_like(y, dtype=np.float32)
    models = []
    fold_corrs = []
    importances = []

    for fold, (tr_idx, va_idx) in enumerate(splitter.split(X)):
        X_tr, y_tr = X.iloc[tr_idx], y[tr_idx]
        X_va, y_va = X.iloc[va_idx], y[va_idx]

        if HAS_LGB and cfg.use_lightgbm:
            model = lgb.LGBMRegressor(
                n_estimators=2000,
                learning_rate=0.05,
                num_leaves=63,
                colsample_bytree=0.8,
                subsample=0.8,
                subsample_freq=1,
                min_child_samples=50,
                reg_alpha=0.1,
                reg_lambda=0.2,
                random_state=RANDOM_SEED + fold,
                n_jobs=-1,
            )
            model.fit(
                X_tr, y_tr,
                eval_set=[(X_va, y_va)],
                eval_metric="l2",
                callbacks=[lgb.early_stopping(stopping_rounds=100), lgb.log_evaluation(200)],
            )
            va_pred = model.predict(X_va, num_iteration=model.best_iteration_)
            try:
                importances.append(model.feature_importances_)
            except Exception:
                pass
        elif HAS_CAT and cfg.use_catboost:
            model = CatBoostRegressor(
                iterations=2000,
                learning_rate=0.05,
                depth=8,
                loss_function='RMSE',
                random_seed=RANDOM_SEED + fold,
                verbose=False
            )
            model.fit(X_tr, y_tr, eval_set=(X_va, y_va), use_best_model=True)
            va_pred = model.predict(X_va)
        else:
            model = RandomForestRegressor(
                n_estimators=400,
                max_depth=14,
                random_state=RANDOM_SEED + fold,
                n_jobs=-1,
            )
            model.fit(X_tr, y_tr)
            va_pred = model.predict(X_va)

        models.append(model)
        oof_pred[va_idx] = va_pred.astype(np.float32)
        corr = np.nan if len(y_va) == 0 else pearsonr(y_va, va_pred)[0]
        fold_corrs.append(corr)
        print(f"[Clean] Fold {fold}: Pearson corr={corr:.5f}, n_va={len(y_va)}")

    overall_corr = pearsonr(y, oof_pred)[0]
    print(f"[Clean] Overall OOF Pearson corr={overall_corr:.5f}")

    imp_df = None
    if importances and HAS_LGB and cfg.use_lightgbm:
        imp_arr = np.vstack(importances)
        imp_mean = imp_arr.mean(axis=0)
        imp_df = pd.DataFrame({"feature": feature_names, "importance": imp_mean}).sort_values("importance", ascending=False)

    return {
        "models": models,
        "feature_names": feature_names,
        "oof_pred": oof_pred,
        "oof_corr": overall_corr,
        "fold_corrs": fold_corrs,
        "importances": imp_df,
        "y_true": y,
        "t_idx": t_idx,
    }


