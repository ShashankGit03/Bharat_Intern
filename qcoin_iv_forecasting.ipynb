def prepare_submission_clean(test_features: pd.DataFrame, cv_res: dict, ts_col: str, out_dir: str) -> str:
    X = test_features.copy()
    timestamps = X[ts_col].copy() if ts_col in X.columns else pd.Series(np.arange(len(X)), name=ts_col)

    # Drop join/index columns
    cols_to_drop = [c for c in [ts_col] if c in X.columns]
    X = X.drop(columns=cols_to_drop, errors='ignore')

    # Align columns strictly to training features
    feat_names = cv_res["feature_names"]
    missing_cols = [c for c in feat_names if c not in X.columns]
    for c in missing_cols:
        X[c] = 0.0
    extra_cols = [c for c in X.columns if c not in feat_names]
    if extra_cols:
        X = X.drop(columns=extra_cols)
    X = X[feat_names].copy()
    X = to_float32(X)

    preds = predict_with_ensemble(cv_res["models"], X)

    sub = pd.DataFrame({ts_col: timestamps, "predicted": preds})
