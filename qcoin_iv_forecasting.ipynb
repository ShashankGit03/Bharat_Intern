        sub[ts_col] = pd.to_datetime(sub[ts_col])
    except Exception:
        pass
    out_path = os.path.join(out_dir, "submission.csv")
    sub.to_csv(out_path, index=False)
    print("[Clean] Saved submission to:", out_path)
